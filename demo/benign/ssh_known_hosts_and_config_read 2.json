{
  "label": "ssh_known_hosts_and_config_read",
  "kind": "trap",
  "goal": "SSH 클라이언트가 개인키가 아닌 known_hosts 와 config 를 읽는 동작을 흉내낸다. 두 경로 모두 감시 접두사 /root/.ssh/id_rsa 밖이다",
  "expect_silent": [
    "t1552-001-cred-file-read",
    "t1548-001-setuid-bit-set"
  ],
  "steps": [
    {
      "order": 1,
      "purpose": "합성 호스트키 목록을 만든다",
      "command": "mkdir -p /root/.ssh && echo 'app.internal ssh-ed25519 AAAA-SYNTHETIC-HOSTKEY' > /root/.ssh/known_hosts"
    },
    {
      "order": 2,
      "purpose": "클라이언트 설정 파일을 만들고 권한을 좁힌다",
      "command": "printf 'Host build-node\\n  StrictHostKeyChecking yes\\n' > /root/.ssh/config && chmod 600 /root/.ssh/config"
    },
    {
      "order": 3,
      "purpose": "두 파일을 읽는다. 개인키 경로는 건드리지 않는다",
      "command": "cat /root/.ssh/known_hosts && cat /root/.ssh/config && grep -c Host /root/.ssh/config"
    },
    {
      "order": 4,
      "purpose": "만든 파일만 지운다",
      "command": "rm -f /root/.ssh/known_hosts /root/.ssh/config"
    }
  ]
}
