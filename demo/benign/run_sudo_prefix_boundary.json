{
  "label": "run_sudo_prefix_boundary",
  "kind": "trap",
  "goal": "/var/run 아래에서 이름이 sudo로 시작하지만 타임스탬프 디렉터리 /var/run/sudo/ts/ 가 아닌 경로를 쓴다.",
  "expect_silent": [
    "t1548-003-sudo-abuse"
  ],
  "steps": [
    {
      "order": 1,
      "purpose": "런타임 디렉터리와 리포트 로그를 만든다.",
      "command": "mkdir -p /var/run/sudoscan && printf 'scan started\\n' > /var/run/sudoers-report.log"
    },
    {
      "order": 2,
      "purpose": "스캐너 상태 파일을 쓰고 읽는다.",
      "command": "printf 'state=idle\\n' > /var/run/sudoscan/state && cat /var/run/sudoscan/state"
    },
    {
      "order": 3,
      "purpose": "두 파일을 합쳐 줄 수를 센다.",
      "command": "cat /var/run/sudoers-report.log /var/run/sudoscan/state | wc -l"
    },
    {
      "order": 4,
      "purpose": "만든 런타임 파일을 모두 지운다.",
      "command": "rm -rf /var/run/sudoscan /var/run/sudoers-report.log"
    }
  ]
}
