{
  "label": "process_table_inspection",
  "kind": "trap",
  "goal": "운영자가 프로세스 목록과 상태 파일을 읽어 무엇이 도는지 살핀다. 디버거처럼 보이지만 붙지도 않고 쓰지도 않으며, 컨테이너 판별에 쓰이는 파일도 열지 않는다.",
  "expect_silent": [
    "t1055-008-ptrace-inject",
    "t1055-009-proc-mem-inject",
    "t1613-container-discovery",
    "t1562-001-defense-tamper",
    "t1105-tmp-exec"
  ],
  "steps": [
    {
      "order": 1,
      "purpose": "프로세스 목록을 받아 파일로 저장한다. ps 가 없는 최소 이미지에서는 /proc 의 숫자 디렉터리 목록으로 대신한다.",
      "command": "mkdir -p /tmp/pb-inspect; (ps 2>/dev/null || ls -1 /proc | grep '^[0-9]') > /tmp/pb-inspect/ps.txt; wc -l < /tmp/pb-inspect/ps.txt"
    },
    {
      "order": 2,
      "purpose": "자기 프로세스의 상태 파일을 읽는다. 읽기만 하고 쓰지 않는다.",
      "command": "head -12 /proc/self/status"
    },
    {
      "order": 3,
      "purpose": "1번 프로세스의 실행 인자를 읽어 무엇이 떠 있는지 확인한다.",
      "command": "head -c 120 /proc/1/cmdline; echo"
    },
    {
      "order": 4,
      "purpose": "proc 아래 숫자 디렉터리 수를 세어 프로세스 개수를 본다.",
      "command": "ls /proc | grep -c '^[0-9]'"
    },
    {
      "order": 5,
      "purpose": "저장한 목록 파일을 지운다.",
      "command": "rm -rf /tmp/pb-inspect"
    }
  ]
}
