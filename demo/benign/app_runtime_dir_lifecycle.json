{
  "label": "app_runtime_dir_lifecycle",
  "kind": "normal",
  "goal": "서비스가 시작하면서 런타임 디렉터리와 pid 파일을 만들고 정리하는 동작이다. 소켓과 시크릿 경로가 모인 /run 아래를 쓰지만 소켓에 붙지도, 시크릿을 읽지도 않는다.",
  "expect_silent": [
    "t1610-runtime-socket-connect",
    "t1613-container-discovery",
    "t1611-host-mount",
    "t1552-001-cred-file-read"
  ],
  "steps": [
    {
      "order": 1,
      "purpose": "런타임 디렉터리를 만든다.",
      "command": "mkdir -p /run/myapp"
    },
    {
      "order": 2,
      "purpose": "현재 셸의 pid 를 pid 파일에 기록한다.",
      "command": "echo $$ > /run/myapp/app.pid"
    },
    {
      "order": 3,
      "purpose": "만들어진 런타임 파일을 확인한다.",
      "command": "ls -l /run/myapp && cat /run/myapp/app.pid"
    },
    {
      "order": 4,
      "purpose": "짧게 대기해 서비스가 살아 있는 상태를 흉내낸다.",
      "command": "sleep 1"
    },
    {
      "order": 5,
      "purpose": "런타임 디렉터리를 지운다.",
      "command": "rm -rf /run/myapp"
    }
  ]
}
