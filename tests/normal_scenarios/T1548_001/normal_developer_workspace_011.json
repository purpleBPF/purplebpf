{
  "technique_id": "T1548.001",
  "goal": "개발자 공동 작업 디렉터리의 그룹 권한 유지를 위해 symbolic 방식으로 SGID를 설정한다.",
  "steps": [
    {
      "order": 1,
      "command": "mkdir -p /tmp/pbpf-dev-workspace",
      "purpose": "개발자 공동 작업 공간을 생성한다."
    },
    {
      "order": 2,
      "command": "chmod g+s /tmp/pbpf-dev-workspace",
      "purpose": "새 작업물이 동일 그룹을 유지하도록 SGID 비트를 추가한다."
    }
  ]
}
