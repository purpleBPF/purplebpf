{
  "schema_version": 1,
  "action_vocabulary": [
    "EXECUTE_PROGRAM",
    "EXECUTE_FILE",
    "CREATE_FILE",
    "WRITE_FILE",
    "READ_FILE",
    "CREATE_MEMORY_FILE",
    "CHANGE_FILE_PERMISSION",
    "CONNECT_ENDPOINT",
    "CONNECT_SOCKET",
    "CREATE_NAMESPACE",
    "ENTER_NAMESPACE",
    "MOUNT_FILESYSTEM",
    "TRACE_PROCESS",
    "WRITE_PROCESS_MEMORY",
    "TERMINATE_PROCESS",
    "LOAD_KERNEL_MODULE",
    "LOAD_BPF_PROGRAM",
    "MODIFY_SECURITY_CONTROL"
  ],
  "context_vocabulary": [
    "program_type",
    "program_category",
    "privilege_context",
    "path_type",
    "backing",
    "file_state",
    "data_type",
    "credential_type",
    "permission",
    "endpoint_type",
    "socket_type",
    "namespace_type",
    "namespace_context",
    "target_context",
    "source_type",
    "operation",
    "interface",
    "process_type",
    "control_type",
    "module_source",
    "bpf_type",
    "uid_transition",
    "transfer_source"
  ],
  "path_groups": {
    "temporary": ["/tmp/", "/var/tmp/", "/dev/shm/"]
  },
  "rules": [
    {
      "id": "execute-shell-program",
      "match": {"executable_in": ["bash", "sh", "dash", "zsh", "ksh"]},
      "emit": {
        "action": "EXECUTE_PROGRAM",
        "context": {"program_type": {"const": "shell"}},
        "evidence": {"executable": {"from": "executable.raw"}}
      }
    },
    {
      "id": "execute-temporary-file",
      "match": {"executable_path_prefix_group": "temporary"},
      "emit": {
        "action": "EXECUTE_FILE",
        "context": {"path_type": {"const": "temporary"}},
        "evidence": {"executable": {"from": "executable.raw"}}
      }
    },
    {
      "id": "execute-with-sudo",
      "match": {"executable": "sudo"},
      "emit": {
        "action": "EXECUTE_PROGRAM",
        "context": {"privilege_context": {"const": "sudo"}},
        "evidence": {"executable": {"from": "executable.normalized"}}
      }
    },
    {
      "id": "create-file",
      "match": {"executable": "touch"},
      "iterate": {"resources": {"direction": "produces", "type": "file"}},
      "emit": {
        "action": "CREATE_FILE",
        "context": {
          "path_type": {
            "path_group_of": {"from": "iteration.resource.identity.path"}
          }
        },
        "evidence": {
          "executable": {"from": "executable.normalized"},
          "resource": {"from": "iteration.resource"}
        }
      }
    },
    {
      "id": "chmod-setuid",
      "match": {
        "executable": "chmod",
        "operand": {
          "position": 1,
          "regex": "(^|,)u\\+s($|,)|^4[0-7]{3}$"
        }
      },
      "emit": {
        "action": "CHANGE_FILE_PERMISSION",
        "context": {"permission": {"const": "setuid"}},
        "evidence": {
          "executable": {"from": "executable.normalized"},
          "operand": {"from": "operand.1"}
        }
      }
    },
    {
      "id": "chmod-setgid",
      "match": {
        "executable": "chmod",
        "operand": {
          "position": 1,
          "regex": "(^|,)g\\+s($|,)|^2[0-7]{3}$"
        }
      },
      "emit": {
        "action": "CHANGE_FILE_PERMISSION",
        "context": {"permission": {"const": "setgid"}},
        "evidence": {
          "executable": {"from": "executable.normalized"},
          "operand": {"from": "operand.1"}
        }
      }
    },
    {
      "id": "create-namespace",
      "match": {"executable": "unshare"},
      "iterate": {
        "options": {
          "values": {
            "-m": "mount",
            "--mount": "mount",
            "-u": "uts",
            "--uts": "uts",
            "-i": "ipc",
            "--ipc": "ipc",
            "-n": "net",
            "--net": "net",
            "-p": "pid",
            "--pid": "pid",
            "-U": "user",
            "--user": "user",
            "-C": "cgroup",
            "--cgroup": "cgroup",
            "-T": "time",
            "--time": "time"
          }
        }
      },
      "emit": {
        "action": "CREATE_NAMESPACE",
        "context": {"namespace_type": {"from": "iteration.value"}},
        "evidence": {
          "executable": {"from": "executable.normalized"},
          "option": {"from": "iteration.option"}
        }
      }
    },
    {
      "id": "mount-filesystem",
      "iterate": {
        "facts": {
          "type": "mount",
          "identity_present": ["source", "target"]
        }
      },
      "emit": {
        "action": "MOUNT_FILESYSTEM",
        "context": {
          "operation": {"from": "iteration.fact.attributes.operation"},
          "source_type": {"from": "iteration.fact.attributes.source_type"},
          "target_context": {
            "from": "iteration.fact.attributes.target_context"
          }
        },
        "evidence": {
          "source_command": {"from": "raw_command"},
          "executable": {"from": "executable.normalized"},
          "source_fact": {"from": "iteration.fact"},
          "source": {"from": "iteration.fact.identity.source"},
          "target": {"from": "iteration.fact.identity.target"}
        }
      }
    },
    {
      "id": "enter-namespace",
      "iterate": {
        "facts": {
          "type": "namespace",
          "attributes": {"operation": "enter"}
        }
      },
      "emit": {
        "action": "ENTER_NAMESPACE",
        "context": {
          "namespace_type": {"from": "iteration.fact.attributes.kind"},
          "namespace_context": {
            "from": "iteration.fact.attributes.namespace_context"
          }
        },
        "evidence": {
          "source_command": {"from": "raw_command"},
          "executable": {"from": "executable.normalized"},
          "source_fact": {"from": "iteration.fact"},
          "target_pid": {"from": "iteration.fact.identity.target_pid"},
          "option": {"from": "iteration.fact.evidence.option"}
        }
      }
    },
    {
      "id": "connect-cloud-metadata-endpoint",
      "iterate": {
        "facts": {
          "type": "endpoint",
          "attributes": {"class": "cloud_metadata"},
          "identity_present": ["url"]
        }
      },
      "emit": {
        "action": "CONNECT_ENDPOINT",
        "context": {
          "endpoint_type": {"from": "iteration.fact.attributes.class"}
        },
        "evidence": {
          "source_command": {"from": "raw_command"},
          "executable": {"from": "executable.normalized"},
          "source_fact": {"from": "iteration.fact"},
          "url": {"from": "iteration.fact.identity.url"}
        }
      }
    },
    {
      "id": "write-downloaded-file",
      "iterate": {
        "facts": {
          "type": "transfer",
          "attributes": {"direction": "download"},
          "identity_present": ["source", "output_path"]
        }
      },
      "emit": {
        "action": "WRITE_FILE",
        "context": {
          "transfer_source": {"const": "external"},
          "path_type": {
            "from": "iteration.fact.attributes.output_path_type"
          }
        },
        "evidence": {
          "source_command": {"from": "raw_command"},
          "executable": {"from": "executable.normalized"},
          "source_fact": {"from": "iteration.fact"},
          "source_url": {"from": "iteration.fact.identity.source"},
          "output_path": {"from": "iteration.fact.identity.output_path"}
        }
      }
    },
    {
      "id": "read-file-access",
      "iterate": {
        "facts": {
          "type": "file_access",
          "attributes": {"operation": "read"},
          "identity_present": ["path"]
        }
      },
      "emit": {
        "action": "READ_FILE",
        "context": {
          "data_type": {"from": "iteration.fact.attributes.data_type"},
          "credential_type": {
            "from": "iteration.fact.attributes.credential_type"
          },
          "path_type": {"from": "iteration.fact.attributes.path_type"}
        },
        "evidence": {
          "source_command": {"from": "raw_command"},
          "executable": {"from": "executable.normalized"},
          "source_fact": {"from": "iteration.fact"},
          "path": {"from": "iteration.fact.identity.path"},
          "classification_rule": {
            "from": "iteration.fact.evidence.classification_rule"
          }
        }
      }
    }
  ]
}
