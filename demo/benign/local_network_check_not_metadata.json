{
  "label": "local_network_check_not_metadata",
  "kind": "trap",
  "goal": "네트워크 설정을 점검하고 루프백으로만 연결을 시도한다. 파일 안에 169.254.169.254 문자열이 있어도 클라우드 메타데이터 주소로 나가지는 않는다.",
  "expect_silent": [
    "t1552-005-cloud-metadata",
    "t1613-container-discovery",
    "exec-admin-tools"
  ],
  "steps": [
    {
      "order": 1,
      "purpose": "DNS 설정을 확인한다.",
      "command": "cat /etc/resolv.conf || true"
    },
    {
      "order": 2,
      "purpose": "호스트 매핑 파일을 확인한다.",
      "command": "cat /etc/hosts"
    },
    {
      "order": 3,
      "purpose": "라우팅 테이블을 읽는다.",
      "command": "head -5 /proc/net/route || true"
    },
    {
      "order": 4,
      "purpose": "메타데이터 주소 문자열이 담긴 샘플 파일을 만들고 검색한 뒤 지운다. grep 결과와 무관하게 지우도록 && 대신 ; 로 이었다.",
      "command": "echo '169.254.169.254 metadata.internal' > /tmp/hosts.sample; grep 169.254.169.254 /tmp/hosts.sample; rm -f /tmp/hosts.sample"
    },
    {
      "order": 5,
      "purpose": "루프백의 닫힌 포트로 연결을 시도한다. /dev/tcp 는 bash 전용이라 최소 이미지의 sh 에서 아무 일도 일어나지 않으므로 wget 으로 바꿨다. nc 계열은 exec-admin-tools 에 걸리므로 쓰지 않는다.",
      "command": "command -v wget >/dev/null 2>&1 && wget -q -T 1 -O /dev/null http://127.0.0.1:9 2>/dev/null; true"
    }
  ]
}
