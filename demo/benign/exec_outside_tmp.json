{
  "label": "exec_outside_tmp",
  "kind": "trap",
  "technique_id": "T1105",
  "goal": "임시 경로가 아닌 설치 경로에 도구를 두고 실행하는 동작이다",
  "expect_silent": [
    "t1105-tmp-exec",
    "exec-admin-tools"
  ],
  "steps": [
    {
      "order": 1,
      "purpose": "보고용 스크립트를 로컬 설치 경로에 설치한다",
      "command": "echo '#!/bin/sh' > /usr/local/bin/wf-report && echo 'echo report-done' >> /usr/local/bin/wf-report"
    },
    {
      "order": 2,
      "purpose": "설치한 스크립트 resource를 등록한다",
      "command": "touch /usr/local/bin/wf-report"
    },
    {
      "order": 3,
      "purpose": "설치한 스크립트에 일반 실행 권한을 부여한다",
      "command": "chmod 755 /usr/local/bin/wf-report"
    },
    {
      "order": 4,
      "purpose": "설치한 스크립트를 실행한다",
      "command": "/usr/local/bin/wf-report"
    },
    {
      "order": 5,
      "purpose": "같은 스크립트를 실제로 다른 디렉터리인 /opt 아래로 복사해 실행한다",
      "command": "mkdir -p /opt/agent/bin && cp /usr/local/bin/wf-report /opt/agent/bin/wf-collect && /opt/agent/bin/wf-collect"
    },
    {
      "order": 6,
      "purpose": "설치한 파일을 제거한다",
      "command": "rm -f /usr/local/bin/wf-report && rm -rf /opt/agent"
    }
  ]
}
