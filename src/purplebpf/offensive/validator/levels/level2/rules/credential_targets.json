{
  "schema_version": 1,
  "targets": [
    {
      "id": "credential-aws-credentials",
      "match": {"path_suffix": "/.aws/credentials"},
      "data_type": "credential",
      "credential_type": "aws_credentials"
    },
    {
      "id": "credential-kubeconfig",
      "match": {"path_suffix": "/.kube/config"},
      "data_type": "credential",
      "credential_type": "kubeconfig"
    },
    {
      "id": "credential-kubernetes-service-account-token",
      "match": {
        "exact_path": "/var/run/secrets/kubernetes.io/serviceaccount/token"
      },
      "data_type": "credential",
      "credential_type": "service_account_token"
    },
    {
      "id": "credential-ssh-private-key-rsa",
      "match": {"path_suffix": "/.ssh/id_rsa"},
      "data_type": "credential",
      "credential_type": "ssh_private_key"
    },
    {
      "id": "credential-ssh-private-key-ed25519",
      "match": {"path_suffix": "/.ssh/id_ed25519"},
      "data_type": "credential",
      "credential_type": "ssh_private_key"
    }
  ]
}
