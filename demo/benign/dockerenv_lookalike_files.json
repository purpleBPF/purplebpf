{
  "label": "dockerenv_lookalike_files",
  "kind": "trap",
  "goal": "이름이 /.dockerenv 와 비슷한 파일을 만들고 읽는다. 규칙은 정확히 /.dockerenv 만 보므로 이름이 한 글자라도 다르면 조용해야 한다.",
  "expect_silent": [
    "t1613-container-discovery",
    "t1105-tmp-exec"
  ],
  "steps": [
    {
      "order": 1,
      "purpose": "점이 빠진 이름과 확장자가 붙은 이름으로 파일을 만든다.",
      "command": "touch /dockerenv /.dockerenv.bak /tmp/.dockerenv"
    },
    {
      "order": 2,
      "purpose": "만든 파일들을 읽는다.",
      "command": "cat /dockerenv /.dockerenv.bak /tmp/.dockerenv"
    },
    {
      "order": 3,
      "purpose": "루트 디렉터리에서 비슷한 이름을 훑는다. ls 는 stat 만 하고 파일을 열지 않는다.",
      "command": "ls -la / | grep docker || true"
    },
    {
      "order": 4,
      "purpose": "이름만 비슷한 무시 파일을 만들고 읽는다.",
      "command": "echo 'node_modules' > /.dockerignore && cat /.dockerignore"
    },
    {
      "order": 5,
      "purpose": "만든 파일을 모두 지운다. 원래 있던 /.dockerenv 는 목록에 없으므로 건드리지 않는다.",
      "command": "rm -f /dockerenv /.dockerenv.bak /tmp/.dockerenv /.dockerignore"
    }
  ]
}
