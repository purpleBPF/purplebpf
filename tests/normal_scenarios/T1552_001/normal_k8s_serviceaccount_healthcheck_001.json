{
  "technique_id": "T1552.001",
  "goal": "Kubernetes 애플리케이션이 정상적인 인증 상태 확인을 위해 ServiceAccount 토큰을 읽는다.",
  "steps": [
    {
      "order": 1,
      "command": "mkdir -p /var/run/secrets/kubernetes.io/serviceaccount && printf 'fake-service-account-token\\n' > /var/run/secrets/kubernetes.io/serviceaccount/token",
      "purpose": "테스트용 ServiceAccount 토큰 파일을 준비한다."
    },
    {
      "order": 2,
      "command": "cat /var/run/secrets/kubernetes.io/serviceaccount/token > /dev/null",
      "purpose": "애플리케이션이 정상적인 인증 상태 확인 과정에서 ServiceAccount 토큰을 읽는다."
    }
  ]
}
