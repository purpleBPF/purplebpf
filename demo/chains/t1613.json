{
  "technique_id": "T1613",
  "goal": "컨테이너 내부에서 자원과 환경을 정찰한다",
  "steps": [
    {
      "order": 1,
      "purpose": "컨테이너 여부 확인",
      "command": "cat /proc/self/cgroup; cat /.dockerenv 2>/dev/null || true"
    },
    {
      "order": 2,
      "purpose": "마운트와 프로세스 열거",
      "command": "cat /proc/self/mountinfo | head -20; ps aux 2>/dev/null || true"
    }
  ]
}
