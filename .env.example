POSTGRES_USER=purplebpf
POSTGRES_PASSWORD=changeme
POSTGRES_DB=purplebpf
POSTGRES_PORT=5433
DATABASE_URL=postgresql://purplebpf:changeme@localhost:5433/purplebpf

NEO4J_AUTH=neo4j/changeme
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687

# Ollama (gemma) 설정
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma2:2b
# Slack 2차 검수 — 알림 전송 + 버튼 콜백(승인/반려) + 결정 영속화.
# 셋업 절차(앱 생성·ngrok·signing secret·webhook)는 docs/slack/README.md 참고.
# SLACK_WEBHOOK_URL   : Incoming Webhook(알림 전송, 단방향) URL
# SLACK_SIGNING_SECRET: 버튼 클릭 콜백이 진짜 Slack 요청인지 검증하는 서명 비밀키
#                       (Slack 앱 관리 페이지 Basic Information > Signing Secret)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_SIGNING_SECRET=changeme

GRAFANA_PORT=3000
# 호스트에서 직접 VM docker에 붙을 때만 필요. dagster/executor는 VM 안에서
# 실행되며 PBPF_ENV_FILE 방식으로 처리되므로 보통 불필요.
DOCKER_HOST=unix:///Users/YOUR_USER/.lima/purplebpf/sock/docker.sock
