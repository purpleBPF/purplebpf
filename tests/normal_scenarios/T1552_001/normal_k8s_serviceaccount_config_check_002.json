{
  "technique_id": "T1552.001",
  "goal": "운영 점검 도구가 Kubernetes ServiceAccount 토큰 존재 여부와 내용을 정상적으로 확인한다.",
  "steps": [
    {
      "order": 1,
      "command": "mkdir -p /run/secrets/kubernetes.io/serviceaccount && printf 'fake-runtime-token\\n' > /run/secrets/kubernetes.io/serviceaccount/token",
      "purpose": "운영 점검용 가짜 ServiceAccount 토큰을 준비한다."
    },
    {
      "order": 2,
      "command": "head -n 1 /run/secrets/kubernetes.io/serviceaccount/token > /dev/null",
      "purpose": "운영 점검 도구가 토큰 파일을 정상적으로 읽어 설정 상태를 확인한다."
    }
  ]
}
