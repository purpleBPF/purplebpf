{
  "technique_id": "T1552.001",
  "goal": "운영 도구가 ServiceAccount 토큰 파일의 무결성 확인을 위해 내용을 읽는다.",
  "steps": [
    {
      "order": 1,
      "command": "mkdir -p /run/secrets/kubernetes.io/serviceaccount && printf 'fake-integrity-token\\n' > /run/secrets/kubernetes.io/serviceaccount/token",
      "purpose": "무결성 검사 테스트용 토큰을 준비한다."
    },
    {
      "order": 2,
      "command": "sha256sum /run/secrets/kubernetes.io/serviceaccount/token > /dev/null",
      "purpose": "운영 도구가 토큰 파일의 체크섬 계산을 위해 정상적으로 파일을 읽는다."
    }
  ]
}
