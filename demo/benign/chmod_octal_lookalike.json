{
  "label": "chmod_octal_lookalike",
  "kind": "trap",
  "technique_id": "T1548.001",
  "goal": "4755 와 겉모습이 비슷한 네 자리 8진수 모드를 쓴다. 앞자리가 0 이거나 1(스티키, 512)이라 규칙의 마스크 04000/02000 에 걸리지 않는다",
  "expect_silent": [
    "t1548-001-setuid-bit-set",
    "t1105-tmp-exec"
  ],
  "steps": [
    {
      "order": 1,
      "purpose": "작업 디렉터리를 만든다",
      "command": "mkdir -p /var/tmp/pbpf-octal"
    },
    {
      "order": 2,
      "purpose": "대상 파일 세 개를 만든다",
      "command": "touch /var/tmp/pbpf-octal /var/tmp/pbpf-octal/a /var/tmp/pbpf-octal/b /var/tmp/pbpf-octal/c"
    },
    {
      "order": 3,
      "purpose": "앞자리 0 을 붙인 네 자리 모드를 준다",
      "command": "chmod 0755 /var/tmp/pbpf-octal/a && chmod 0644 /var/tmp/pbpf-octal/b && chmod 0400 /var/tmp/pbpf-octal/c"
    },
    {
      "order": 4,
      "purpose": "스티키 비트 1777 과 다른 네 자리 모드를 더 준다",
      "command": "chmod 1777 /var/tmp/pbpf-octal && chmod 0775 /var/tmp/pbpf-octal/a && chmod 0640 /var/tmp/pbpf-octal/b"
    },
    {
      "order": 5,
      "purpose": "모드를 확인하고 정리한다",
      "command": "ls -ld /var/tmp/pbpf-octal && ls -l /var/tmp/pbpf-octal && rm -rf /var/tmp/pbpf-octal"
    }
  ]
}
