{
  "technique_id": "T1548.001",
  "goal": "운영 백업 파일을 여러 관리자가 공유하기 위해 백업 디렉터리에 SGID를 설정한다.",
  "steps": [
    {
      "order": 1,
      "command": "mkdir -p /tmp/pbpf-backup-share",
      "purpose": "관리자들이 사용할 백업 디렉터리를 준비한다."
    },
    {
      "order": 2,
      "command": "chmod 2770 /tmp/pbpf-backup-share",
      "purpose": "그룹 내부에서만 백업 파일을 공유하도록 SGID 권한을 설정한다."
    }
  ]
}
