{
  "label": "app_config_read_update",
  "kind": "normal",
  "goal": "서비스가 시작할 때 자기 설정 파일을 읽고 값을 고치는 평범한 동작이다",
  "expect_silent": [
    "t1552-001-cred-file-read",
    "t1548-003-sudo-abuse",
    "t1548-001-setuid-bit-set"
  ],
  "steps": [
    {
      "order": 1,
      "purpose": "설정 파일을 만든다",
      "command": "mkdir -p /etc/pbpf-app && printf 'listen=0.0.0.0:8080\\nlog_level=info\\n' > /etc/pbpf-app/app.conf"
    },
    {
      "order": 2,
      "purpose": "설정을 읽어 필요한 항목을 뽑는다",
      "command": "cat /etc/pbpf-app/app.conf && grep log_level /etc/pbpf-app/app.conf"
    },
    {
      "order": 3,
      "purpose": "로그 수준을 바꿔 다시 쓴다",
      "command": "sed -i 's/log_level=info/log_level=warn/' /etc/pbpf-app/app.conf && cat /etc/pbpf-app/app.conf"
    },
    {
      "order": 4,
      "purpose": "설정 디렉터리를 지운다",
      "command": "rm -rf /etc/pbpf-app"
    }
  ]
}
